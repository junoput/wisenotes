    { "expr": "1 +", "code": "empty" },
    { "expr": "2x", "code": "unexpected", "why": "no implicit multiplication yet" },
    { "expr": "2 pi", "code": "unexpected" },
    { "expr": "(1 + 2", "code": "unclosed" },
    { "expr": "sin(1", "code": "unclosed" },
    { "expr": "1 + 2)", "code": "unexpected" },
    { "expr": "* 2", "code": "unexpected" },
    { "expr": "b + 1", "code": "unknown_name" },
