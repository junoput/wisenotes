{
  "_about": "Shared cases for the graph block's spec language (20261022-064). The Python parser (app/graph_spec.py, tests/test_graph_spec.py) runs them now; the JS parser of slice 2 runs the same file. A value is a number, or the string NaN, Infinity or -Infinity. Values compare with a relative tolerance of 1e-12. A rejection names the error code only: messages may differ between the two parsers, codes may not.",

  "values": [
    { "expr": "1 + 2 * 3", "value": 7 },
    { "expr": "(1 + 2) * 3", "value": 9 },
    { "expr": "10 - 4 - 3", "value": 3 },
    { "expr": "12 / 4 / 3", "value": 1 },
    { "expr": "2^3^2", "value": 512, "why": "^ is right-associative" },
    { "expr": "-2^2", "value": -4, "why": "unary minus binds looser than ^" },
    { "expr": "2^-1", "value": 0.5 },
    { "expr": "--3", "value": 3 },
    { "expr": "+3", "value": 3 },
    { "expr": ".5 + 0.25", "value": 0.75 },
    { "expr": "pi", "value": 3.141592653589793 },
    { "expr": "e", "value": 2.718281828459045 },
    { "expr": "sin(pi/2)", "value": 1 },
    { "expr": "cos(0)", "value": 1 },
    { "expr": "tan(0)", "value": 0 },
    { "expr": "asin(1)", "value": 1.5707963267948966 },
    { "expr": "acos(1)", "value": 0 },
    { "expr": "atan(1)", "value": 0.7853981633974483 },
    { "expr": "atan2(1, 1)", "value": 0.7853981633974483 },
    { "expr": "sqrt(16)", "value": 4 },
    { "expr": "abs(-3)", "value": 3 },
    { "expr": "exp(0)", "value": 1 },
    { "expr": "ln(e)", "value": 1 },
    { "expr": "log(1000)", "value": 3, "why": "log is base 10; ln is natural" },
    { "expr": "floor(-1.5)", "value": -2 },
    { "expr": "ceil(-1.5)", "value": -1 },
    { "expr": "min(2, 3)", "value": 2 },
    { "expr": "max(2, 3)", "value": 3 },
    { "expr": "a * x + 1", "env": { "a": 2, "x": 3 }, "value": 7 },
    { "expr": "sin(a)^2 + cos(a)^2", "env": { "a": 0.7 }, "value": 1 },
    { "expr": "1/0", "value": "Infinity" },
    { "expr": "-1/0", "value": "-Infinity" },
    { "expr": "0/0", "value": "NaN" },
    { "expr": "0^-1", "value": "Infinity" },
    { "expr": "sqrt(-1)", "value": "NaN", "why": "a domain error is a gap in the graph, not a failure" },
    { "expr": "ln(0)", "value": "NaN", "why": "JS gives -Infinity; both parsers must agree, so the case pins NaN and slice 2 maps it" },
    { "expr": "(-8)^(1/3)", "value": "NaN" },
    { "expr": "2^2000", "value": "Infinity" }
  ],

  "rejected": [
