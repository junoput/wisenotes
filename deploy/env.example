# Copy to deploy/.env on the serving host and edit. deploy/.env is gitignored:
# it stays on that host, never in the repo. The app itself needs no secrets.
WISENOTES_REF=origin/develop       # what deploy.sh deploys when given no --ref
WISENOTES_BRANCH=develop           # what preview.sh follows
WISENOTES_PORT=8000
WISENOTES_BIND=127.0.0.1           # published on the tailnet by tailscale serve, so loopback is enough
WISENOTES_DATA=/path/outside/any/checkout   # host dir bind-mounted at /app/data; survives redeploys
# WISENOTES_NAME=wisenotes         # container/image name; a rehearsal uses another name
# Deploy beside the serving container, with no gap on the tailnet URL (both, or neither):
# WISENOTES_SPARE_PORT=8001        # a second port, registered; the new container is smoked there
# WISENOTES_SERVE_SLOT=8094        # the tailscale serve port that proxies to WISENOTES_PORT
# WISENOTES_DRAIN_SECONDS=30       # how long a change of writer waits for writes in flight
# WISENOTES_SMOKE_SECONDS=60
