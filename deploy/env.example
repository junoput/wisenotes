# Copy to deploy/.env on the serving host and edit. deploy/.env is gitignored:
# it stays on that host, never in the repo. The app itself needs no secrets.
WISENOTES_REF=origin/main          # what to deploy; a rehearsal passes --ref instead
WISENOTES_PORT=8000
WISENOTES_BIND=127.0.0.1           # agrarius: 100.87.237.97 (tailnet only)
WISENOTES_DATA=/home/usr_cat/wisenotes   # host dir bind-mounted at /app/data; survives redeploys
# WISENOTES_NAME=wisenotes         # container/image name; a rehearsal uses another name
# WISENOTES_SMOKE_SECONDS=60
